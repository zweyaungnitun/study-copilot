# Environment Configuration for StudyPilot

# Application
APP_NAME=StudyPilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=dev-secret-key-study-pilot-change-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./studypilot.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studypilot

# AI / LLM Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Vector DB
CHROMA_PERSIST_DIR=./chroma_data

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
