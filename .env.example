# Environment Configuration for StudyPilot

# Application
APP_NAME=StudyPilot
APP_ENV=development
DEBUG=True
API_V1_STR=/api
SECRET_KEY=dev-secret-key-study-pilot-change-in-production
AUTH_TOKEN_TTL_HOURS=168

# Admin site: these usernames become admins on register/login (JSON list)
ADMIN_USERNAMES=["admin"]

# LLM token quota per user per calendar month (0 = unlimited); admins can override per user
DEFAULT_MONTHLY_TOKEN_LIMIT=500000
PROCTOR_LIVE_WINDOW_SECONDS=45

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./studypilot.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studypilot

# AI / LLM Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_AGENT_MODEL=gemini-3.1-pro-preview   # optional: deeper (slower) tutor agent
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Tutor agent
AGENT_MAX_STEPS=5
AGENT_RESEARCH_MAX_STEPS=3
AGENT_THINKING_BUDGET=1024

# Vector DB
CHROMA_PERSIST_DIR=./chroma_data

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_UPLOAD_PAGES=800
DEFAULT_STORAGE_PAGE_LIMIT=3000

# Ingestion pipeline (see docker-compose.yml)
# REDIS_URL=redis://localhost:6379      # set to process uploads on ARQ workers: python -m app.worker
INGEST_MODE=auto                        # auto | arq | background | inline
VECTOR_BACKEND=chroma                   # chroma | pgvector
# PGVECTOR_URL=postgresql+asyncpg://studypilot:studypilot@localhost:5432/studypilot
STORAGE_BACKEND=local                   # local | s3
# S3_BUCKET=uploads
# S3_ENDPOINT_URL=http://localhost:8333  # SeaweedFS/MinIO/R2; omit for AWS S3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
OCR_PROVIDER=auto                       # auto | gemini | tesseract | none
